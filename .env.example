# Base URL used by the API client (src/lib/api/client.ts).
# Kept relative ("/api") on purpose: the Vite dev server proxies /api to the
# real backend (see vite.config.ts), so the browser never needs CORS and no
# absolute backend URL/secret ever ships in the frontend bundle.
VITE_API_BASE_URL=/api

# Organization SSO (account-pilot). None of these are secrets: this is a
# public SPA client (implicit/PKCE flow, no client_secret). See
# src/lib/auth/authConfig.ts for how they're consumed.
VITE_AUTH_SERVER=https://account-pilot.tamin.ir/
VITE_AUTH_CLIENT_ID=136f697b158116450170417a5105224e

# Leave empty to fall back to window.location.origin at runtime (recommended
# for dev: the IDP has http://localhost:4200 pre-registered for this
# client_id, which is exactly window.location.origin when running `npm run
# dev` on the fixed port 4200 — see vite.config.ts).
VITE_AUTH_REDIRECT_URI=
